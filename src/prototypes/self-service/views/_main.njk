{% extends "layout/_template.njk" %}
{% set breadCrumbsUrl %}
{% if prevPage %}
    {{pageInfo.rootPath}}/{{prevPage}}.html
{% else %}
/
{% endif %}
{% endset %}
{% set pageConfig = {
    "header": {
        "title": "Statistical Preparation Platform",
        "logoHref": '/',
        "titleLogoHref": pageInfo.rootPath + '#0',
        "navigation": {
            "id": "main-nav",
            "ariaLabel": "Main menu",
            "currentPath": pageInfo.url,
            "itemsList": [
                {
                    "text": "Survey configuration",
                    "url": pageInfo.rootPath + "/views/migrate.html"
                },
                {
                    "text": "Contributor search",
                    "url": pageInfo.rootPath + "/views/contributor.html"
                },
                {
                    "text": "Dashboards",
                    "url": pageInfo.rootPath + "/views/dashboard.html"
                },
                {
                    "text": "Work prioritisation tool",
                    "url": pageInfo.rootPath + "/views/prioritisation.html"
                },
                {
                    "text": "Results",
                    "url": pageInfo.rootPath + "/views/results.html"
                },
                {
                    "text": "Reference data",
                    "url": pageInfo.rootPath + "/views/referencedata.html"
                }
            ],
            "toggleNavigationButton": {
                "text": "Menu",
                "ariaLabel": "Toggle main menu"
            }
        }
    },
    "breadcrumbs": {
        "ariaLabel": 'Breadcrumbs',
        "itemsList": breadcrumbs | default([
            {
                "linkClasses": 'js-previous' if prevPage else '',
                "url": breadCrumbsUrl | trim,
                "text": 'Previous'
            }
        ])
    },
    "footer": {
        "oglLink": true,
        "legal": [
            {
                "itemsList": [
                    {
                        "text": "Clear data",
                        "url": "#0",
                        "id": "clear-data-link"
                    }
                ]
            }
        ]
    }
} %}

{% block head %}
    <link rel="stylesheet" href="/prototypes/self-service/styles.css"/>
{% endblock %}

{% block main %}
{% endblock %}

{% block bodyEnd %}
    <script src="/prototypes/self-service/index.js"></script>
{% endblock %}
