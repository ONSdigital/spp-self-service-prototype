    <h1>Migrate a survey onto the Statistical Preparation Platform</h1>

    <aside class="ons-table-of-contents-container" aria-label="Table of contents">
        <nav class="ons-table-of-contents" aria-label="Table of contents">
            {{
                onsList({
                    "element": "ul",
                    "variants": "dashed",
                    "classes": "ons-u-mb-no",
                    "itemsList": [
                        {
                            "url": "#migrate-survey",
