{% set tabItems = [] %}

    {% for form in forms %}
        {% set trs = [] %}
        {% for row in form.questions %}
            {% set requiredValue = "true" if row.required else "false" %}
            {% set readOnlyValue = "true" if row.readOnly else "false" %}
            {% set typeLabel = row.type + (" (read only)" if row.readOnly else "") %}
            {% set checkboxId = "select-question-" + dataset + "-" + form.id + "-" + (row.code | lower) + "-" + (loop.index | string) %}
            {% set questionAttributes = "data-form-id='" + form.id + "' data-form-title='" + form.title + "' data-source-form-id='" + (form.sourceId | string) + "' data-question-code='" + row.code + "' data-question-label='" + row.text + "' data-question-type='" + row.type + "' data-question-required='" + requiredValue + "' data-question-readonly='" + readOnlyValue + "' data-question-decimal-places='" + (row.decimalPlaces | string) + "' data-question-max-length='" + (row.maxLength | string) + "' data-question-derived-formula='" + row.derivedFormula + "'" %}
            {% set selectQuestionCheckbox = "<span class='ons-checkbox'><input type='checkbox' id='" + checkboxId + "' class='ons-checkbox__input' data-select-question-checkbox " + questionAttributes + " value='" + row.code + "' /><label class='ons-checkbox__label' for='" + checkboxId + "' aria-label='Select " + row.code + " on " + form.title + "'></label></span>" %}

            {% set tr = {
                "tds": [
                    { "value": row.code },
                    { "value": row.text },
                    { "value": typeLabel },
                    { "value": "Yes" if row.required else "No" },
                    { "value": selectQuestionCheckbox | safe }
                ]
            } %}

            {% set trs = (trs.push(tr), trs) %}
        {% endfor %}

        {% set tableHtml %}
            {{ onsTable({
                "ths": [
                    { "value": "Question code" },
                    { "value": "Question" },
                    { "value": "Type" },
                    { "value": "Required" },
                    { "value": "Validation rules" }
                ],
                "trs": trs
            }) }}
        {% endset %}

        {% set tab = { "id": form.id, "title": form.title, "content": tableHtml | safe } %}
        {% set tabItems = (tabItems.push(tab), tabItems) %}
    {% endfor %}

    {{ onsTabs({ "title": "Forms", "tabs": tabItems }) }}
{% endmacro %}
