---
group: Working Version
title: No task list
layout: validation_rules/views/_main
prevPage: views/configuration/rules/template
---
{% from "components/button/_macro.njk" import onsButton %}
{% from "components/details/_macro.njk" import onsDetails %}
{% from "components/input/_macro.njk" import onsInput %}
{% from "components/radios/_macro.njk" import onsRadios %}
{% from "components/select/_macro.njk" import onsSelect %}
{% from "components/textarea/_macro.njk" import onsTextarea %}

{% set breadcrumbs = [
    {
        "url": pageInfo.rootPath + "/views/migrate.html",
        "text": "Survey configuration"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/survey.html",
        "text": "Survey",
        "id": "breadcrumb-survey"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/rules.html",
        "text": "Rule summary"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/create.html",
        "text": "Add a validation rule"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/template.html",
        "text": "Select template"
    },
    {
        "text": "Configure rule"
    }
] %}

{% set responseTypeOptions = [
    { "value": "response", "text": "Response", "selected": true },
    { "value": "adjustedresponse", "text": "Adjusted response" }
] %}

{% set thresholdTypeOptions = [
    { "value": "constant", "text": "Constant", "selected": true },
    { "value": "surveyconfig", "text": "Survey configuration data" }
] %}

{% set operatorOptions = [
    { "value": "", "text": "-- Select --", "selected": true },
    { "value": "=", "text": "=" },
    { "value": "!=", "text": "!=" },
    { "value": ">", "text": ">" },
    { "value": "<", "text": "<" },
    { "value": ">=", "text": ">=" },
    { "value": "<=", "text": "<=" }
] %}

{% macro primaryQuestionBlock(idPrefix, labelText) %}
    <div class="spp-parameter-block">
        {{
            onsRadios({
                "id": idPrefix + "-question-type-fieldset",
                "name": idPrefix + "-question-type",
                "legend": labelText,
                "description": "Select the response type.",
                "borderless": true,
                "value": "response",
                "radios": [
                    {
                        "id": idPrefix + "-question-type-response",
                        "label": {
                            "text": "Response"
                        },
                        "value": "response",
                        "checked": true
                    },
                    {
                        "id": idPrefix + "-question-type-adjustedresponse",
                        "label": {
                            "text": "Adjusted response"
                        },
                        "value": "adjustedresponse"
                    }
                ]
            })
        }}
    </div>
{% endmacro %}

{% macro comparisonQuestionBlock(idPrefix, fieldKey, labelText, defaultQcode="Q100", usePrimaryDefault=true, defaultOffset="0") %}
    {% set qcodeAttributes = { "placeholder": "Question code", "data-default-primary-qcode": "true" } if usePrimaryDefault else { "placeholder": "Question code" } %}
    {% set qcodeDescription = "Question code (defaults to the selected question)." if usePrimaryDefault else "Question code (for example, Q40)." %}
    <div class="spp-parameter-block">
        {{
            onsRadios({
                "id": idPrefix + "-" + fieldKey + "-type-fieldset",
                "name": idPrefix + "-" + fieldKey + "-type",
                "legend": labelText,
                "description": "Select the response type.",
                "borderless": true,
                "value": "response",
                "radios": [
                    {
                        "id": idPrefix + "-" + fieldKey + "-type-response",
                        "label": {
                            "text": "Response"
                        },
                        "value": "response",
                        "checked": true
                    },
                    {
                        "id": idPrefix + "-" + fieldKey + "-type-adjustedresponse",
                        "label": {
                            "text": "Adjusted response"
                        },
                        "value": "adjustedresponse"
                    }
                ]
            })
        }}
        <div class="ons-u-mt-s">
            {{
                onsInput({
                    "id": idPrefix + "-" + fieldKey + "-qcode",
                    "name": idPrefix + "-" + fieldKey + "-qcode",
                    "fieldClasses": "ons-u-mb-no",
                    "value": defaultQcode,
                    "autocomplete": "off",
                    "attributes": qcodeAttributes,
                    "label": {
                        "text": labelText + " question code",
                        "description": qcodeDescription,
                        "classes": "ons-u-vh"
                    }
                })
            }}
        </div>
        <div class="ons-u-mt-s">
            {{
                onsInput({
                    "id": idPrefix + "-" + fieldKey + "-offset",
                    "name": idPrefix + "-" + fieldKey + "-offset",
                    "type": "number",
                    "fieldClasses": "ons-u-mb-no",
                    "value": defaultOffset,
                    "autocomplete": "off",
                    "label": {
                        "text": labelText + " period offset",
                        "description": "Period offset (for example, 1 = 1 month, 12 = 1 year).",
                        "classes": "ons-u-vh"
                    }
                })
            }}
        </div>
    </div>
{% endmacro %}

{% block main %}
    <h1>Configure validation rule instance / enter parameter</h1>

    <div id="configure-rule-container">
        <h2 id="configure-template-code" class="ons-u-mb-2xs">VDLPGTX</h2>
        <p id="configure-template-name" class="ons-u-fs-r ons-u-mb-m">Value Decrease Last Period Greater Than X</p>

        <dl class="spp-parameter-summary">
            <dt>Question</dt>
            <dd id="configure-question">Q100</dd>
            <dt>Form</dt>
            <dd id="configure-form">Form 1 (009)</dd>
        </dl>

        <form id="configure-rule-form">
            {# VDLPGTX #}
            <div data-template-section="VDLPGTX" class="spp-parameter-vertical">
                {{ primaryQuestionBlock("vdlpgtx", "Question") }}
                {{ comparisonQuestionBlock("vdlpgtx", "comparison", "Comparison question", "Q100", true, "1") }}

                <div class="spp-parameter-block">
                    {{
                        onsRadios({
                            "id": "vdlpgtx-threshold-type-fieldset",
                            "name": "vdlpgtx-threshold-type",
                            "legend": "Threshold",
                            "description": "Select the threshold type.",
                            "borderless": true,
                            "value": "constant",
                            "radios": [
                                {
                                    "id": "vdlpgtx-threshold-type-constant",
                                    "label": {
                                        "text": "Constant",
                                        "description": "Input the number below"
                                    },
                                    "value": "constant",
                                    "checked": true
                                },
                                {
                                    "id": "vdlpgtx-threshold-type-surveyconfig",
                                    "label": {
                                        "text": "Survey configuration data",
                                        "description": "Input the field name below"
                                    },
                                    "value": "surveyconfig"
                                }
                            ]
                        })
                    }}
                    <div class="ons-u-mt-s">
                        {{
                            onsInput({
                                "id": "vdlpgtx-threshold-value",
                                "name": "vdlpgtx-threshold-value",
                                "fieldClasses": "ons-u-mb-no",
                                "autocomplete": "off",
                                "label": {
                                    "text": "Threshold value",
                                    "description": "Enter the threshold value.",
                                    "classes": "ons-u-vh"
                                }
                            })
                        }}
                    </div>
                </div>

                <div class="spp-parameter-block">
                    {{
                        onsInput({
                            "id": "vdlpgtx-percentage-value",
                            "name": "vdlpgtx-percentage-value",
                            "type": "number",
                            "value": "0",
                            "autocomplete": "off",
                            "label": {
                                "text": "Percentage",
                                "description": "Enter the percentage threshold."
                            },
                            "suffix": {
                                "title": "per cent",
                                "text": "%",
                                "id": "vdlpgtx-percentage-suffix"
                            }
                        })
                    }}
                </div>
            </div>

            {# QVQ #}
            <div data-template-section="QVQ" class="spp-parameter-vertical" hidden>
                {{ primaryQuestionBlock("qvq", "Question") }}
                {{ comparisonQuestionBlock("qvq", "comparison", "Comparison question") }}

                <div class="spp-parameter-block">
                    {{
                        onsSelect({
                            "id": "qvq-operator",
                            "name": "qvq-operator",
                            "fieldClasses": "ons-u-mb-no",
                            "label": {
                                "text": "Operator",
                                "description": "Select the comparison operator."
                            },
                            "options": operatorOptions
                        })
                    }}
                </div>
            </div>

            {# VRWV #}
            <div data-template-section="VRWV" class="spp-parameter-vertical" hidden>
                {{ primaryQuestionBlock("vrwv", "Question 1") }}
                {{ comparisonQuestionBlock("vrwv", "q2", "Question 2", "", false) }}
                {{ comparisonQuestionBlock("vrwv", "q3", "Question 3", "", false) }}
                {{ comparisonQuestionBlock("vrwv", "q4", "Question 4", "", false) }}
            </div>

            {# QEZCGZ #}
            <div data-template-section="QEZCGZ" class="spp-parameter-vertical" hidden>
                {{ primaryQuestionBlock("qezcgz", "Question") }}
                {{ comparisonQuestionBlock("qezcgz", "comparison", "Comparison question") }}
            </div>

            {# VGZAQTC #}
            <div data-template-section="VGZAQTC" class="spp-parameter-vertical" hidden>
                {{ primaryQuestionBlock("vgzaqtc", "Question") }}
                {{ comparisonQuestionBlock("vgzaqtc", "comparison", "Comparison question") }}

                <div class="spp-parameter-block">
                    {{
                        onsSelect({
                            "id": "vgzaqtc-operator",
                            "name": "vgzaqtc-operator",
                            "fieldClasses": "ons-u-mb-no",
                            "label": {
                                "text": "Comparison operator",
                                "description": "Select the comparison operator."
                            },
                            "options": operatorOptions
                        })
                    }}
                </div>

                <div class="spp-parameter-block">
                    {{
                        onsInput({
                            "id": "vgzaqtc-threshold",
                            "name": "vgzaqtc-threshold",
                            "type": "number",
                            "fieldClasses": "ons-u-mb-no",
                            "value": "0",
                            "autocomplete": "off",
                            "label": {
                                "text": "Threshold",
                                "description": "Enter the threshold value."
                            }
                        })
                    }}
                </div>
            </div>

            <hr class="spp-section-divider">

            {% call onsDetails({
                "id": "formula-details",
                "title": "Formula"
            }) %}
                <div id="formula-content" class="spp-formula-content">
                    <p>abs(question - comparison_question) &gt; threshold</p>
                    <p>AND</p>
                    <p>question &lt; (comparison_question * percentage)</p>
                    <p>AND</p>
                    <p>previous_period_and_status_clear_exists = 1</p>
                    <p>AND</p>
                    <p>previous_form_id = current_form_id</p>
                    <p>AND</p>
                    <p>question != -1</p>
                </div>

                <div class="ons-u-mt-l">
                    {{
                        onsButton({
                            "text": "Refresh formula",
                            "type": "button",
                            "variants": "secondary",
                            "id": "refresh-formula-button"
                        })
                    }}
                    {{
                        onsButton({
                            "text": "Show base formula",
                            "type": "button",
                            "variants": "secondary",
                            "id": "toggle-formula-mode-button"
                        })
                    }}
                    <p id="configure-status" class="ons-u-mt-m ons-u-vh" role="status" aria-live="polite"></p>
                </div>
            {% endcall %}

            <hr class="spp-section-divider">

            <div class="ons-u-mt-l">
                {{
                    onsRadios({
                        "id": "rule-severity-fieldset",
                        "name": "rule-severity",
                        "legend": "Severity level",
                        "description": "Errors cannot be changed and must be fixed, while warnings can be reviewed and adjusted if appropriate.",
                        "borderless": true,
                        "value": "error",
                        "radios": [
                            {
                                "id": "rule-severity-error",
                                "label": {
                                    "text": "Error"
                                },
                                "value": "error"
                            },
                            {
                                "id": "rule-severity-warning",
                                "label": {
                                    "text": "Warning"
                                },
                                "value": "warning"
                            }
                        ]
                    })
                }}
            </div>

            <div class="ons-u-mt-l">
                {{
                    onsTextarea({
                        "id": "rule-error-message",
                        "name": "rule-error-message",
                        "rows": 4,
                        "attributes": {
                            "placeholder": "Error message"
                        },
                        "label": {
                            "text": "Severity level message",
                            "description": "Modify the pre filled response."
                        }
                    })
                }}
            </div>

            <div class="ons-u-mt-l">
                {{
                    onsButton({
                        "text": "Save and continue",
                        "type": "submit",
                        "id": "save-rule-button",
                        "iconType": ""
                    })
                }}
            </div>
        </form>
    </div>

    <div id="configure-fallback" hidden>
        <h2 id="configure-fallback-template-code" class="ons-u-mb-2xs"></h2>
        <p id="configure-fallback-template-name" class="ons-u-fs-r ons-u-mb-m" hidden></p>
        <p>Configuration for this validation rule template is not available yet.</p>
    </div>
{% endblock %}
