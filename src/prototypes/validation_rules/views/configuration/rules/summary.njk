{% from "components/button/_macro.njk" import onsButton %}
{% from "components/summary/_macro.njk" import onsSummary %}

{% set breadcrumbs = [
    {
        "url": pageInfo.rootPath + "/views/migrate.html",
        "text": "Survey configuration"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/survey.html",
        "text": "Survey",
        "id": "breadcrumb-survey"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/rules.html",
        "text": "Rule summary"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/create.html",
        "text": "Add a validation rule"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/template.html",
        "text": "Select template"
    },
    {
        "url": pageInfo.rootPath + "/views/configuration/rules/configure.html",
        "text": "Configure rule"
    },
    {
        "text": "Summary"
    }
] %}

{% block main %}
    <h1>Summary page</h1>

    {{
        onsSummary({
            "summaries": [
                {
                    "title": "Validation rules",
                    "groups": [
                        {
                            "rows": [
                                {
                                    "id": "summary-question-row",
