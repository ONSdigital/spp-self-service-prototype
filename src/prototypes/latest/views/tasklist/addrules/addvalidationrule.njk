---
group: Self Service
title: Add Validation Rule
layout: latest/views/_main
prevPage: views/tasklist/tasklist
---
{% from "components/accordion/_macro.njk" import onsAccordion %}
{% from "components/table/_macro.njk" import onsTable %}
{% from "components/button/_macro.njk" import onsButton %}

{% set breadcrumbs = [
    {
        "url": pageInfo.rootPath + "/views/home.html",
        "text": "Home"
    },
    {
        "url": pageInfo.rootPath + "/views/migrate.html",
        "text": "Migrate a survey"
    },
    {
        "url": pageInfo.rootPath + "/views/tasklist/tasklist.html",
        "text": "Migration tasks"
    }
] %}

{% block main %}
    <h1>Add a validation rule to a question</h1>
    <p>To add a validation rule, select the questions in the survey where you want to apply it. Every unique question in the survey appears on this page.</p>

    {% set firstAccordionTable %}
        {{
            onsTable({
                "id": "survey-period-table",
                "ths": [
                    { "value": "Select", "thClasses": "spp-col-select" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question", "thClasses": "spp-col-question" },
                    { "value": "Answer type", "thClasses": "spp-col-answertype" },
                    { "value": "Rules", "thClasses": "spp-col-rules" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": "" },
                            { "value": "Q1" },
                            { "value": "Start date" },
                            { "value": "Date" },
                            { "value": "" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": "" },
                            { "value": "Q2" },
                            { "value": "End date" },
                            { "value": "Date" },
                            { "value": "" }
                        ]
                    }
                ]
            })
        }}
    {% endset %}

    {% set secondAccordionTable %}
        {{
            onsTable({
                "id": "employees-table",
                "ths": [
                    { "value": "Select", "thClasses": "spp-col-select" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question", "thClasses": "spp-col-question" },
                    { "value": "Answer type", "thClasses": "spp-col-answertype" },
                    { "value": "Rules", "thClasses": "spp-col-rules" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q50" class="ons-checkbox__input" value="q50" /><label class="ons-checkbox__label" for="checkbox-q50" aria-label="Select Q50"></label></span>' },
                            { "value": "Q50" },
                            { "value": "Number of employees" },
                            { "value": "Numeric" },
                            { "value": "" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q51" class="ons-checkbox__input" value="q51" /><label class="ons-checkbox__label" for="checkbox-q51" aria-label="Select Q51"></label></span>' },
                            { "value": "Q51" },
                            { "value": "Number of male employees working more than 30 hours per week" },
