                            { "value": "" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q53" class="ons-checkbox__input" value="q53" /><label class="ons-checkbox__label" for="checkbox-q53" aria-label="Select Q53"></label></span>' },
                            { "value": "Q53" },
                            { "value": "Number of female employees working more than 30 hours per week" },
                            { "value": "Numeric" },
                            { "value": "" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q54" class="ons-checkbox__input" value="q54" /><label class="ons-checkbox__label" for="checkbox-q54" aria-label="Select Q54"></label></span>' },
                            { "value": "Q54" },
                            { "value": "Number of female employees working 30 hours or less per week" },
                            { "value": "Numeric" },
                            { "value": "" }
                        ]
                    }
                ]
            })
        }}
    {% endset %}

    {% set thirdAccordionTable %}
        {{
            onsTable({
                "id": "locations-table",
                "ths": [
                    { "value": "Select", "thClasses": "spp-col-select" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question", "thClasses": "spp-col-question" },
                    { "value": "Answer type", "thClasses": "spp-col-answertype" },
                    { "value": "Rules", "thClasses": "spp-col-rules" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q101" class="ons-checkbox__input" value="q101" /><label class="ons-checkbox__label" for="checkbox-q101" aria-label="Select Q101"></label></span>' },
