                            { "value": "How many new sites opened since the last period" },
                            { "value": "Numeric" },
                            { "value": "" }
                        ]
                    }
                ]
            })
        }}
    {% endset %}

    {% set fourthAccordionTable %}
        {{
            onsTable({
                "id": "turnover-table",
                "ths": [
                    { "value": "Select", "thClasses": "spp-col-select" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question", "thClasses": "spp-col-question" },
                    { "value": "Answer type", "thClasses": "spp-col-answertype" },
                    { "value": "Rules", "thClasses": "spp-col-rules" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q40" class="ons-checkbox__input" value="q40" /><label class="ons-checkbox__label" for="checkbox-q40" aria-label="Select Q40"></label></span>' },
                            { "value": "Q40" },
                            { "value": "Total turnover" },
