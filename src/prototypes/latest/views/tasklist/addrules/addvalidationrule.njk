                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-q42" class="ons-checkbox__input" value="q42" /><label class="ons-checkbox__label" for="checkbox-q42" aria-label="Select Q42"></label></span>' },
                            { "value": "Q42" },
                            { "value": "Value of grants, donations, legacies, investments and incorporated income" },
                            { "value": "Currency" },
