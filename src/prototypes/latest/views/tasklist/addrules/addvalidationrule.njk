                    }
                ]
            })
        }}
    {% endset %}

    {{
        onsAccordion({
            "id": "validation-rules-accordion",
            "allButton": {
                "open": "Show all",
                "close": "Hide all",
                "openAriaLabel": "Show all sections",
                "closeAriaLabel": "Hide all sections",
                "attributes": {
                    "data-toggle-button": "accordion-toggle-all"
                }
            },
            "itemsList": [
                {
                    "title": "Survey period and response data",
                    "content": firstAccordionTable | safe
                },
                {
                    "title": "Employees",
                    "content": secondAccordionTable | safe
                },
                {
                    "title": "Locations",
                    "content": thirdAccordionTable | safe
                },
                {
                    "title": "Turnover",
                    "content": fourthAccordionTable | safe
                }
            ]
        })
    }}

    <div class="ons-u-mt-m ons-u-mb-m">
        {{
            onsButton({
                "text": "Add rule to selected questions",
                "variants": "secondary",
                "url": pageInfo.rootPath + "/views/tasklist/addrules/selectrule.html",
                "noIcon": true
            })
        }}
    </div>

    <h2 class="ons-u-mt-l">Finish adding validation rules</h2>

    <div class="ons-u-mt-m">
        {{
            onsButton({
                "text": "Finish adding rules",
                "url": pageInfo.rootPath + "/views/tasklist/addrules/completerules.html",
                "noIcon": true,
                "id": "btn-finish-rules"
            })
        }}
    </div>
{% endblock %}
