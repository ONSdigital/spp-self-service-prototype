---
group: Self Service
title: Configure Date Adjustment
layout: latest/views/_main
prevPage: views/tasklist/addforms/formslist
---
{% from "components/button/_macro.njk" import onsButton %}
{% from "components/table/_macro.njk" import onsTable %}

{% set breadcrumbs = [
    {
        "url": pageInfo.rootPath + "/views/home.html",
        "text": "Home"
    },
    {
        "url": pageInfo.rootPath + "/views/migrate.html",
        "text": "Migrate a survey"
    },
    {
        "url": pageInfo.rootPath + "/views/tasklist/tasklist.html",
        "text": "Migration tasks"
    },
    {
        "url": pageInfo.rootPath + "/views/tasklist/addforms/formslist.html",
        "text": "Forms list"
    }
] %}

{% block main %}
    <h1>Configure date adjustment</h1>
    <p>Select which questions in the survey forms can have date adjustment applied, and verify their response types.</p>

    {% set dateAdjustmentTable %}
        {{
            onsTable({
                "id": "date-adjustment-table",
                "ths": [
                    { "value": "Enable date adjustment", "thClasses": "spp-col-date-adj" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question Label", "thClasses": "spp-col-question" },
                    { "value": "Response type", "thClasses": "spp-col-answertype" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": '<div style="text-align: center; width: 100%;">N/A</div>' },
                            { "value": "Q1" },
                            { "value": "Start date" },
                            { "value": "Date" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<div style="text-align: center; width: 100%;">N/A</div>' },
                            { "value": "Q2" },
                            { "value": "End date" },
                            { "value": "Date" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q40" class="ons-checkbox__input" value="q40" /><label class="ons-checkbox__label" for="checkbox-date-adj-q40" aria-label="Select Q40"></label></span>' },
                            { "value": "Q40" },
                            { "value": "Total turnover" },
                            { "value": "Currency" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q41" class="ons-checkbox__input" value="q41" /><label class="ons-checkbox__label" for="checkbox-date-adj-q41" aria-label="Select Q41"></label></span>' },
                            { "value": "Q41" },
                            { "value": "Total amount receivable in respect of invoices raised during period" },
                            { "value": "Currency" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q42" class="ons-checkbox__input" value="q42" /><label class="ons-checkbox__label" for="checkbox-date-adj-q42" aria-label="Select Q42"></label></span>' },
                            { "value": "Q42" },
                            { "value": "Value of grants, donations, legacies, investments and incorporated income" },
                            { "value": "Currency" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q50" class="ons-checkbox__input" value="q50" /><label class="ons-checkbox__label" for="checkbox-date-adj-q50" aria-label="Select Q50"></label></span>' },
                            { "value": "Q50" },
