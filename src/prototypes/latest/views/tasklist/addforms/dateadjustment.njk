                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q101" class="ons-checkbox__input" value="q101" /><label class="ons-checkbox__label" for="checkbox-date-adj-q101" aria-label="Select Q101"></label></span>' },
                            { "value": "Q101" },
                            { "value": "How many sites do you have" },
                            { "value": "Numeric" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q102" class="ons-checkbox__input" value="q102" /><label class="ons-checkbox__label" for="checkbox-date-adj-q102" aria-label="Select Q102"></label></span>' },
                            { "value": "Q102" },
                            { "value": "How many new sites opened since the last period" },
                            { "value": "Numeric" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q103" class="ons-checkbox__input" value="q103" /><label class="ons-checkbox__label" for="checkbox-date-adj-q103" aria-label="Select Q103"></label></span>' },
                            { "value": "Q103" },
                            { "value": "Any other detail about your sites" },
                            { "value": "Text" }
                        ]
                    }
                ]
            })
        }}
