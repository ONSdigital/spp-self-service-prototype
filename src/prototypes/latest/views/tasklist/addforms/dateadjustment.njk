                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q51" class="ons-checkbox__input" value="q51" /><label class="ons-checkbox__label" for="checkbox-date-adj-q51" aria-label="Select Q51"></label></span>' },
                            { "value": "Q51" },
                            { "value": "Number of male employees working more than 30 hours per week" },
                            { "value": "Numeric" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q52" class="ons-checkbox__input" value="q52" /><label class="ons-checkbox__label" for="checkbox-date-adj-q52" aria-label="Select Q52"></label></span>' },
