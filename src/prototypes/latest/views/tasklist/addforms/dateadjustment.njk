                            { "value": "Number of female employees working more than 30 hours per week" },
                            { "value": "Numeric" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-date-adj-q54" class="ons-checkbox__input" value="q54" /><label class="ons-checkbox__label" for="checkbox-date-adj-q54" aria-label="Select Q54"></label></span>' },
                            { "value": "Q54" },
                            { "value": "Number of female employees working 30 hours or less per week" },
                            { "value": "Numeric" }
                        ]
                    },
                    {
