                            { "value": "Q102" },
                            { "value": "How many new sites opened since the last period" },
                            { "value": "Numeric" }
                        ]
                    }
                ]
            })
        }}
    {% endset %}

    <div class="ons-u-mb-l">
        {{ bdodSettingsTable | safe }}
    </div>

    {{
        onsButton({
            "text": "Save and continue",
            "classes": "ons-u-mt-m",
            "url": pageInfo.rootPath + "/views/tasklist/addforms/formslist.html",
            "noIcon": true,
            "id": "btn-save-bdod-settings"
        })
    }}
{% endblock %}
