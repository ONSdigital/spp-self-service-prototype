---
group: Self Service
title: Configure Date Adjustment
layout: self-service/views/_main
prevPage: views/tasklist/addforms/formslist
---
{% from "components/button/_macro.njk" import onsButton %}
{% from "components/table/_macro.njk" import onsTable %}

{% set breadcrumbs = [
    {
        "url": pageInfo.rootPath + "/views/home.html",
        "text": "Home"
    },
    {
        "url": pageInfo.rootPath + "/views/migrate.html",
        "text": "Migrate a survey"
    },
    {
        "url": pageInfo.rootPath + "/views/tasklist/tasklist.html",
        "text": "Migration tasks"
    },
    {
        "url": pageInfo.rootPath + "/views/tasklist/addforms/formslist.html",
        "text": "Forms list"
    }
] %}

{% block main %}
    <h1>Configure BDOD question settings</h1>
    <p>Select which questions in the survey forms can have comments turned on, and which responses should be read only.</p>

    {% set bdodSettingsTable %}
        {{
            onsTable({
                "id": "bdod-settings-table",
                "ths": [
                    { "value": "Comments on", "thClasses": "spp-col-comments" },
                    { "value": "Read only", "thClasses": "spp-col-readonly" },
                    { "value": "Q Code", "thClasses": "spp-col-qcode" },
                    { "value": "Question Label", "thClasses": "spp-col-question" },
                    { "value": "Response type", "thClasses": "spp-col-responsetype" }
                ],
                "trs": [
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-comments-q1" class="ons-checkbox__input" value="q1" /><label class="ons-checkbox__label" for="checkbox-comments-q1" aria-label="Select Comments on Q1"></label></span>' },
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-readonly-q1" class="ons-checkbox__input" value="q1" /><label class="ons-checkbox__label" for="checkbox-readonly-q1" aria-label="Select Read only Q1"></label></span>' },
                            { "value": "Q1" },
                            { "value": "Start date" },
                            { "value": "Date" }
                        ]
                    },
                    {
                        "tds": [
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-comments-q2" class="ons-checkbox__input" value="q2" /><label class="ons-checkbox__label" for="checkbox-comments-q2" aria-label="Select Comments on Q2"></label></span>' },
                            { "value": '<span class="ons-checkbox"><input type="checkbox" id="checkbox-readonly-q2" class="ons-checkbox__input" value="q2" /><label class="ons-checkbox__label" for="checkbox-readonly-q2" aria-label="Select Read only Q2"></label></span>' },
                            { "value": "Q2" },
